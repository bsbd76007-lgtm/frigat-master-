# ── Frigat API ──
NODE_ENV=development
HOST=0.0.0.0
PORT=4000

# Comma-separated browser origins allowed through CORS. CORS_ORIGIN is checked
# first; WEB_ORIGINS is the older name and still works.
CORS_ORIGIN=http://localhost:3000

DATABASE_URL="postgresql://user@localhost:5432/frigat?schema=public"
REDIS_URL="redis://localhost:6379"

# Signs session tokens. Generate per environment: openssl rand -hex 32
JWT_SECRET="change_me"

# ── Cloudflare Turnstile ──
# The SECRET key is a credential and must never be committed. Copy the real
# value from the Cloudflare dashboard into .env (gitignored), not here.
# Its matching public site key lives in apps/web/.env.
#
# With no secret set, auth endpoints answer 503 "turnstile_misconfigured"
# rather than silently accepting traffic. To bring a deployment up before the
# keys exist, set TURNSTILE_DISABLED=true below — it is the only way any
# non-development environment skips the check, and every skip is logged.
TURNSTILE_SECRET_KEY=""
TURNSTILE_DISABLED=""

# ── Payments (NOWPayments) ──
NOWPAYMENTS_API_KEY=""
NOWPAYMENTS_IPN_SECRET=""
NOWPAYMENTS_IPN_CALLBACK_URL=""

# ── Outbound email (OTP delivery) ──
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
