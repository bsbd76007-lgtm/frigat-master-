dist/

# Secrets. .env.example is the committed template and must survive the
# .env.* wildcard above it — without the negation, the template this repo
# tells contributors to copy would itself be untracked.
.env
.env.*

# Build output. Regenerated by `next build` / `tsc`, machine-specific, and
# large — apps/web/.next alone was 447 tracked files churning every diff.
.next/
*.tsbuildinfo
.turbo/
.cache/

*.log
.DS_Store
.claude
.vscode/
CLAUDE.md
graphify-out
.claudeignore
