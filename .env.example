# ─────────────────────────────────────────────────────────────
# FRIGAT — environment template
#
# Copy to .env and fill in. Every value here is a placeholder: never commit a
# real secret to this file, it is tracked in git.
#
# Per-app overrides live in apps/server/.env and apps/web/.env(.local); those
# are gitignored and take precedence for their own workspace.
# ─────────────────────────────────────────────────────────────

# ── Database ──
# Prisma connection string. On a managed host (Neon, Supabase) copy the pooled
# URL and keep sslmode=require.
DATABASE_URL="postgresql://user:password@localhost:5432/frigat?schema=public"

# ── Auth ──
# Signs session tokens. Generate a fresh value per environment:
#   openssl rand -hex 32
# Reusing the development value in production makes every session forgeable.
JWT_SECRET="replace_me_with_openssl_rand_hex_32"

# ── Cloudflare Turnstile ──
# Secret key: server-side only, and a real credential — keep it out of git.
# With this unset the auth endpoints answer 503 "turnstile_misconfigured"
# rather than silently accepting unverified traffic. To bring a deployment up
# before the keys exist, set TURNSTILE_DISABLED=true.
TURNSTILE_SECRET_KEY=""
TURNSTILE_DISABLED=""

# Site key: public by design. Turnstile renders it into the page, so it is not
# a secret — but it must match the secret key above, or every check fails.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ── Networking ──
# Comma-separated browser origins allowed through CORS. CORS_ORIGIN is read
# first; WEB_ORIGINS is the older name and still honoured.
CORS_ORIGIN="http://localhost:3000"

# Where the browser reaches the API. Must be absolute — it is baked into the
# client bundle at build time, so it cannot be changed without a rebuild.
NEXT_PUBLIC_API_URL="http://localhost:4000"
