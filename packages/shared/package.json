{
  "name": "@frigat/shared",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/game.types.d.ts",
      "default": "./dist/types/game.types.js"
    },
    "./provably-fair": {
      "types": "./dist/provably-fair/index.d.ts",
      "default": "./dist/provably-fair/index.js"
    },
    "./constants": {
      "types": "./dist/constants/game.constants.d.ts",
      "default": "./dist/constants/game.constants.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "typescript": "^7.0.2"
  }
}
